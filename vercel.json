{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/fan-letter/:idol",
      "destination": "/fan-letter.html"
    },
    {
      "source": "/letter/:idol",
      "destination": "/fan-letter.html"
    },
    {
